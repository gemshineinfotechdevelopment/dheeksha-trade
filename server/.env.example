# Backend Server Port (Default VPS port)
PORT=5004

# Environment Mode (development / production)
NODE_ENV=production

# Database Connection
# For Local MongoDB installed on VPS:
MONGODB_URI=mongodb://127.0.0.1:27017/dheeksha_trade
# For MongoDB Atlas (if using cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.txhuc3s.mongodb.net/dheeksha_trade?retryWrites=true&w=majority

# Frontend Client URL for CORS
CORS_ORIGIN=https://dheeksha-trade.gemshine.tech

# Cloudinary Storage Configuration for PDF / File Uploads
# Get these from your Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
